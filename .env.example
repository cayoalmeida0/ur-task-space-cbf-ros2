# Identidade do usuario do Ubuntu host. Consulte com: id -u && id -g
HOST_UID=1000
HOST_GID=1000

# Identifica de forma reprodutivel a imagem correspondente a esta revisao.
IMAGE_TAG=0.2.0

# Modelo inicial. Para mudar o ambiente ROS/Gazebo, use por exemplo: ur5e
UR_TYPE=ur3e

# Gripper OnRobot acoplada ao tool0. Valores suportados: rg2 e rg6.
ONROBOT_TYPE=rg2

# Exibe as aproximacoes geometricas das futuras CBFs no RViz e no Gazebo.
# O valor tambem pode ser sobrescrito sem editar este arquivo:
# make sim CBF_VOLUMES=false
CBF_VOLUMES=true

# Oculta os volumes somente no Gazebo, preservando-os no RobotModel do RViz.
# Uso pontual: make sim CBF_VOLUMES_GAZEBO=false
CBF_VOLUMES_GAZEBO=true

# Necessario apenas no perfil do robo real.
ROBOT_IP=192.168.0.10

# RG2 real: serial usa o Tool I/O RS485 do UR; tcp usa a OnRobot Compute Box.
ONROBOT_CONNECTION_TYPE=serial
ONROBOT_DEVICE=/tmp/ttyUR
ONROBOT_IP=192.168.1.1
ONROBOT_PORT=502

# Evita comunicacao DDS acidental com outros experimentos na mesma rede.
ROS_DOMAIN_ID=42

# Use 1 para renderizacao por software. Troque para 0 ao habilitar a GPU no Compose.
LIBGL_ALWAYS_SOFTWARE=1
