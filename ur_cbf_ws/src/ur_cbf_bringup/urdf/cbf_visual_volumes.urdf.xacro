<?xml version="1.0"?>
<!--
  Aproximacoes geometricas visuais para inspecao das futuras CBFs.

  Estes links nao possuem collision nem inertial: aparecem no RViz e no Gazebo,
  acompanham os elos por juntas fixas e nao alteram a fisica da simulacao.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="cbf_sphere_visual" params="name parent xyz radius rgba">
    <link name="${name}_cbf_volume">
      <visual name="${name}_cbf_visual">
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
        <material name="${name}_cbf_material">
          <color rgba="${rgba}"/>
        </material>
      </visual>
    </link>
    <joint name="${name}_cbf_volume_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="${name}_cbf_volume"/>
    </joint>
  </xacro:macro>

  <!-- Uma capsula e formada por um cilindro e duas esferas, todos visuais. -->
  <xacro:macro name="cbf_capsule_visual"
               params="name parent center rpy cap_a cap_b radius length rgba">
    <link name="${name}_cbf_volume">
      <visual name="${name}_cbf_cylinder">
        <origin xyz="${center}" rpy="${rpy}"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${name}_cbf_material">
          <color rgba="${rgba}"/>
        </material>
      </visual>
      <visual name="${name}_cbf_cap_a">
        <origin xyz="${cap_a}" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
        <material name="${name}_cbf_material"/>
      </visual>
      <visual name="${name}_cbf_cap_b">
        <origin xyz="${cap_b}" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
        <material name="${name}_cbf_material"/>
      </visual>
    </link>
    <joint name="${name}_cbf_volume_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="${name}_cbf_volume"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="ur3e_cbf_visual_volumes" params="prefix">
    <xacro:property name="arm_color" value="0.00 0.75 1.00 0.25"/>

    <xacro:cbf_sphere_visual
      name="${prefix}base" parent="${prefix}base_link"
      xyz="0 0 0.075" radius="0.110" rgba="${arm_color}"/>
    <xacro:cbf_sphere_visual
      name="${prefix}shoulder" parent="${prefix}shoulder_link"
      xyz="0 0 0" radius="0.090" rgba="${arm_color}"/>
    <xacro:cbf_capsule_visual
      name="${prefix}upper_arm" parent="${prefix}upper_arm_link"
      center="-0.121775 0 0" rpy="0 1.57079632679 0"
      cap_a="0 0 0" cap_b="-0.24355 0 0"
      radius="0.075" length="0.24355" rgba="${arm_color}"/>
    <xacro:cbf_sphere_visual
      name="${prefix}elbow" parent="${prefix}forearm_link"
      xyz="0 0 0" radius="0.075" rgba="${arm_color}"/>
    <xacro:cbf_capsule_visual
      name="${prefix}forearm" parent="${prefix}forearm_link"
      center="-0.1066 0 0" rpy="0 1.57079632679 0"
      cap_a="0 0 0" cap_b="-0.2132 0 0"
      radius="0.065" length="0.2132" rgba="${arm_color}"/>
    <xacro:cbf_sphere_visual
      name="${prefix}wrist_1" parent="${prefix}wrist_1_link"
      xyz="0 0 0" radius="0.060" rgba="${arm_color}"/>
    <xacro:cbf_sphere_visual
      name="${prefix}wrist_2" parent="${prefix}wrist_2_link"
      xyz="0 0 0" radius="0.058" rgba="${arm_color}"/>
    <xacro:cbf_sphere_visual
      name="${prefix}wrist_3" parent="${prefix}wrist_3_link"
      xyz="0 0 0" radius="0.058" rgba="${arm_color}"/>
  </xacro:macro>

  <xacro:macro name="rg2_cbf_visual_volume" params="prefix">
    <!-- Uma unica capsula cobre corpo, dedos e o TCP nominal da RG2. -->
    <xacro:cbf_capsule_visual
      name="${prefix}rg2" parent="${prefix}onrobot_base_link"
      center="0 0 0.110" rpy="0 0 0"
      cap_a="0 0 0.055" cap_b="0 0 0.165"
      radius="0.090" length="0.110" rgba="1.00 0.45 0.00 0.30"/>
  </xacro:macro>
</robot>
