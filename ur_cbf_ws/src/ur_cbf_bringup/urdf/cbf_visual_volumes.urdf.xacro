<?xml version="1.0"?>
<!--
  Modelo visual de autocolisao corrigido do projeto para o conjunto UR3e/RG2.

  Fonte fixada:
  UAIbot/UAIbotPy@1acb5ed637738aca4ea05945e6c065c3757bc13d
  uaibot/robot/_create_ur_ur3e.py

  Os treze objetos do UR3e derivados da fabrica UAIbot sao relativos aos frames
  DH posteriores a cada junta. Os origins abaixo aplicam as transformacoes
  rigidas DH -> elo URDF da descricao oficial Jazzy. Tipos, dimensoes e poses
  locais dos treze objetos do braco partem da fabrica UAIbot fixada. Neste
  ensaio, c11 usa z=0.115 m; c21 usa x=y=0 e z=0.0415 m; c22 preserva z=0.027 m;
  c23 usa x=-0.2121 m e z=0.025 m; c31 usa x=y=0 e z=-0.020 m; c32 usa x=0,
  y=0 m e comprimento=0.0945 m; c41 usa z=-0.027 m; c42 usa
  x=0, y=0 m e z=0; c51 permanece inalterado; e c52 usa x=0.0011 m, y=-0.026 m e z=-0.030 m.
  A RG2 usa os oito objetos do elo final da fabrica UAIbot: C51/C52 e os seis
  objetos adicionais de esfera, caixas e cilindros. Estes links sao apenas
  visuais e permanecem sincronizados com UR3E_RG2_PROJECT_PRIMITIVES.

  Estes links nao possuem collision nem inertial: aparecem apenas na descricao
  visual usada pelo RViz, acompanham os elos por juntas fixas e nao alteram a
  fisica da simulacao no Gazebo.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="cbf_sphere_visual"
               params="name parent xyz radius rgba">
    <link name="${name}_cbf_volume">
      <visual name="${name}_cbf_visual">
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
        <material name="${name}_cbf_material">
          <color rgba="${rgba}"/>
        </material>
      </visual>
    </link>
    <joint name="${name}_cbf_volume_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="${name}_cbf_volume"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="cbf_cylinder_visual"
               params="name parent xyz rpy radius length rgba">
    <link name="${name}_cbf_volume">
      <visual name="${name}_cbf_visual">
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${name}_cbf_material">
          <color rgba="${rgba}"/>
        </material>
      </visual>
    </link>
    <joint name="${name}_cbf_volume_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="${name}_cbf_volume"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="cbf_box_visual"
               params="name parent xyz rpy size rgba">
    <link name="${name}_cbf_volume">
      <visual name="${name}_cbf_visual">
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry>
          <box size="${size}"/>
        </geometry>
        <material name="${name}_cbf_material">
          <color rgba="${rgba}"/>
        </material>
      </visual>
    </link>
    <joint name="${name}_cbf_volume_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="${name}_cbf_volume"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="ur3e_cbf_visual_volumes" params="prefix">
    <xacro:property name="arm_color" value="0.00 0.75 1.00 0.25"/>

    <!-- UAIbot link 0; ^shoulder_link T_DH0 = Rx(pi/2). -->
    <xacro:cbf_cylinder_visual
      name="${prefix}uaibot_c0" parent="${prefix}shoulder_link"
      xyz="0 0 -0.0469" rpy="0 0 0"
      radius="0.067" length="0.21" rgba="${arm_color}"/>

    <!-- UAIbot link 1; ^upper_arm_link T_DH1 = Tx(-0.24355). -->
    <xacro:cbf_cylinder_visual
      name="${prefix}uaibot_c11" parent="${prefix}upper_arm_link"
      xyz="0.00185 0 0.115" rpy="0 0 1.570796326795"
      radius="0.052" length="0.13" rgba="${arm_color}"/>
    <xacro:cbf_cylinder_visual
      name="${prefix}uaibot_c12" parent="${prefix}upper_arm_link"
      xyz="-0.11815 0 0.12" rpy="-1.570796326795 0 1.570796326795"
      radius="0.05" length="0.2" rgba="${arm_color}"/>
    <xacro:cbf_cylinder_visual
      name="${prefix}uaibot_c13" parent="${prefix}upper_arm_link"
      xyz="-0.24315 0 0.118" rpy="0 0 1.570796326795"
      radius="0.05" length="0.12" rgba="${arm_color}"/>

    <!-- UAIbot link 2; ^forearm_link T_DH2 = Tx(-0.2132). -->
    <xacro:cbf_sphere_visual
      name="${prefix}uaibot_c21" parent="${prefix}forearm_link"
      xyz="0 0 0.0415" radius="0.05" rgba="${arm_color}"/>
    <xacro:cbf_cylinder_visual
      name="${prefix}uaibot_c22" parent="${prefix}forearm_link"
      xyz="-0.1046 0 0.027" rpy="-1.570796326795 0 1.570796326795"
      radius="0.04" length="0.2" rgba="${arm_color}"/>
    <xacro:cbf_cylinder_visual
      name="${prefix}uaibot_c23" parent="${prefix}forearm_link"
      xyz="-0.2121 0 0.025" rpy="0 0 1.570796326795"
      radius="0.035" length="0.09" rgba="${arm_color}"/>

    <!-- UAIbot link 3; ^wrist_1_link T_DH3 = Rx(pi/2). -->
    <xacro:cbf_cylinder_visual
      name="${prefix}uaibot_c31" parent="${prefix}wrist_1_link"
      xyz="0 0 -0.02" rpy="0 0 3.14159265359"
      radius="0.035" length="0.09" rgba="${arm_color}"/>
    <xacro:cbf_cylinder_visual
      name="${prefix}uaibot_c32" parent="${prefix}wrist_1_link"
      xyz="0 0 -0.0011" rpy="-1.570796326795 0 -3.14159265359"
      radius="0.035" length="0.0945" rgba="${arm_color}"/>

    <!-- UAIbot link 4; ^wrist_2_link T_DH4 = Rx(-pi/2). -->
    <xacro:cbf_cylinder_visual
      name="${prefix}uaibot_c41" parent="${prefix}wrist_2_link"
      xyz="0.0011 0 -0.027" rpy="0 0 -1.570796326795"
      radius="0.035" length="0.025" rgba="${arm_color}"/>
    <xacro:cbf_cylinder_visual
      name="${prefix}uaibot_c42" parent="${prefix}wrist_2_link"
      xyz="0 0 0" rpy="1.570796326795 1.570796326795 0"
      radius="0.038" length="0.098" rgba="${arm_color}"/>

    <!-- UAIbot link 5; ^wrist_3_link T_DH5 = I. -->
    <xacro:cbf_cylinder_visual
      name="${prefix}uaibot_c51" parent="${prefix}wrist_3_link"
      xyz="0 0 -0.02" rpy="3.14159265359 0 1.570796326795"
      radius="0.038" length="0.046" rgba="${arm_color}"/>
    <xacro:cbf_cylinder_visual
      name="${prefix}uaibot_c52" parent="${prefix}wrist_3_link"
      xyz="0.0011 -0.026 -0.03" rpy="1.570796326795 1.570796326795 0"
      radius="0.01" length="0.028" rgba="${arm_color}"/>
  </xacro:macro>

  <xacro:macro name="rg2_cbf_visual_volume" params="prefix">
    <!-- Objetos 2..7 do elo 5 original do UAIbot, no frame wrist_3_link. -->
    <xacro:cbf_sphere_visual
      name="${prefix}uaibot_c53" parent="${prefix}wrist_3_link"
      xyz="0.0011 0.004 0.0279" radius="0.05"
      rgba="1.00 0.45 0.00 0.30"/>
    <xacro:cbf_box_visual
      name="${prefix}uaibot_c54" parent="${prefix}wrist_3_link"
      xyz="0.0011 -0.006 0.1079" rpy="0 1.570796326795 0"
      size="0.09 0.07 0.06" rgba="1.00 0.45 0.00 0.30"/>
    <xacro:cbf_box_visual
      name="${prefix}uaibot_c55" parent="${prefix}wrist_3_link"
      xyz="-0.0389 -0.001 0.1529"
      rpy="1.570796326795 0.785398163397 0"
      size="0.075 0.04 0.035" rgba="1.00 0.45 0.00 0.30"/>
    <xacro:cbf_box_visual
      name="${prefix}uaibot_c56" parent="${prefix}wrist_3_link"
      xyz="0.0411 -0.001 0.1529"
      rpy="-1.570796326795 0.785398163397 3.14159265359"
      size="0.075 0.04 0.035" rgba="1.00 0.45 0.00 0.30"/>
    <xacro:cbf_cylinder_visual
      name="${prefix}uaibot_c57" parent="${prefix}wrist_3_link"
      xyz="0.0511 -0.001 0.1979" rpy="3.14159265359 0 1.570796326795"
      radius="0.021" length="0.04" rgba="1.00 0.45 0.00 0.30"/>
    <xacro:cbf_cylinder_visual
      name="${prefix}uaibot_c58" parent="${prefix}wrist_3_link"
      xyz="-0.0489 -0.001 0.1979" rpy="3.14159265359 0 1.570796326795"
      radius="0.021" length="0.04" rgba="1.00 0.45 0.00 0.30"/>
  </xacro:macro>
</robot>
