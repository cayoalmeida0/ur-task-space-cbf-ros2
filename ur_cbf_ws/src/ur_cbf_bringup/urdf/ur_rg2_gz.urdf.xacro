<?xml version="1.0"?>
<!--
  Composicao para Gazebo Harmonic baseada na descricao UR oficial (BSD-3-Clause)
  e na descricao OnRobot RG2 de tonydle/OnRobot_ROS2_Description (MIT).
  A integracao local substitui o plugin Gazebo Classic por gz_ros2_control.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur3e"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="transmission_hw_interface" default=""/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:arg name="ros_namespace" default=""/>
  <!-- O Xacro upstream declara gripper_tcp no escopo da inclusao. -->
  <xacro:property name="prefix" value="$(arg tf_prefix)"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.ros2_control.xacro"/>
  <xacro:include filename="$(find onrobot_description)/urdf/rg2_macro.xacro"/>

  <link name="world"/>
  <link name="ground_plane">
    <visual>
      <geometry><box size="5 5 0"/></geometry>
      <material name="ground_white"><color rgba="1 1 1 0.5"/></material>
    </visual>
    <collision><geometry><box size="5 5 0"/></geometry></collision>
  </link>
  <joint name="ground_plane_joint" type="fixed">
    <origin xyz="0 0 -0.01" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="ground_plane"/>
  </joint>

  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    force_abs_paths="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <xacro:onrobot_rg2 prefix="$(arg tf_prefix)"/>
  <joint name="$(arg tf_prefix)onrobot_base_link_joint" type="fixed">
    <parent link="$(arg tf_prefix)tool0"/>
    <child link="$(arg tf_prefix)onrobot_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 ${-pi/2}"/>
  </joint>

  <gazebo reference="world"/>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
      <ros><namespace>$(arg ros_namespace)</namespace></ros>
    </plugin>
  </gazebo>

  <xacro:ur_ros2_control
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    transmission_hw_interface="$(arg transmission_hw_interface)"/>

  <xacro:macro name="onrobot_simulated_joint" params="joint initial_value">
    <joint name="$(arg tf_prefix)${joint}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_value}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="OnRobotGripper" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:onrobot_simulated_joint joint="finger_width" initial_value="0.110"/>
    <xacro:onrobot_simulated_joint joint="finger_joint" initial_value="-0.35691955"/>
    <xacro:onrobot_simulated_joint joint="left_inner_knuckle_joint" initial_value="0.35691955"/>
    <xacro:onrobot_simulated_joint joint="left_inner_finger_joint" initial_value="-0.35691955"/>
    <xacro:onrobot_simulated_joint joint="right_outer_knuckle_joint" initial_value="0.35691955"/>
    <xacro:onrobot_simulated_joint joint="right_inner_knuckle_joint" initial_value="0.35691955"/>
    <xacro:onrobot_simulated_joint joint="right_inner_finger_joint" initial_value="-0.35691955"/>
  </ros2_control>
</robot>
