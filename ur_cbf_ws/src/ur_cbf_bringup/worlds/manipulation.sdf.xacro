<?xml version="1.0"?>
<!-- Cena parametrica de manipulacao para Gazebo Harmonic. -->
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="table_x" default="-0.35"/>
  <xacro:arg name="table_y" default="0.0"/>
  <xacro:arg name="table_radius" default="0.08"/>
  <xacro:arg name="table_height" default="0.15"/>
  <xacro:arg name="cube_x" default="-0.35"/>
  <xacro:arg name="cube_y" default="0.0"/>
  <xacro:arg name="cube_size" default="0.04"/>
  <xacro:arg name="drop_x" default="-0.30"/>
  <xacro:arg name="drop_y" default="0.18"/>
  <xacro:arg name="box_size_x" default="0.08"/>
  <xacro:arg name="box_size_y" default="0.08"/>
  <xacro:arg name="box_height" default="0.04"/>
  <xacro:arg name="box_wall_thickness" default="0.005"/>
  <xacro:arg name="table_z" default="0.075"/>
  <xacro:arg name="cube_z" default="0.17"/>
  <xacro:arg name="box_base_z" default="0.0025"/>
  <xacro:arg name="box_wall_z" default="0.02"/>
  <xacro:arg name="box_wall_x" default="0.0375"/>
  <xacro:arg name="box_wall_y" default="0.0375"/>

  <world name="manipulation_world">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.70 0.70 0.70 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 1.5 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.4 -0.3 -1.0</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.01 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.18 0.18 0.18 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="manipulation_table">
      <static>true</static>
      <pose>$(arg table_x) $(arg table_y) $(arg table_z) 0 0 0</pose>
      <link name="table_link">
        <collision name="table_collision">
          <geometry>
            <cylinder>
              <radius>$(arg table_radius)</radius>
              <length>$(arg table_height)</length>
            </cylinder>
          </geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="table_visual">
          <geometry>
            <cylinder>
              <radius>$(arg table_radius)</radius>
              <length>$(arg table_height)</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.35 0.35 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="manipulation_cube">
      <pose>$(arg cube_x) $(arg cube_y) $(arg cube_z) 0 0 0</pose>
      <link name="cube_link">
        <inertial>
          <mass>0.064</mass>
          <inertia>
            <ixx>1.7067e-5</ixx><iyy>1.7067e-5</iyy><izz>1.7067e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="cube_collision">
          <geometry><box><size>$(arg cube_size) $(arg cube_size) $(arg cube_size)</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
            <contact><ode><kp>2.0e5</kp><kd>30</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="cube_visual">
          <geometry><box><size>$(arg cube_size) $(arg cube_size) $(arg cube_size)</size></box></geometry>
          <material>
            <ambient>0.85 0.20 0.05 1</ambient>
            <diffuse>0.95 0.30 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="drop_box">
      <static>true</static>
      <pose>$(arg drop_x) $(arg drop_y) 0 0 0 0</pose>
      <link name="box_link">
        <collision name="box_base_collision">
          <pose>0 0 $(arg box_base_z) 0 0 0</pose>
          <geometry><box><size>$(arg box_size_x) $(arg box_size_y) $(arg box_wall_thickness)</size></box></geometry>
        </collision>
        <visual name="box_base_visual">
          <pose>0 0 $(arg box_base_z) 0 0 0</pose>
          <geometry><box><size>$(arg box_size_x) $(arg box_size_y) $(arg box_wall_thickness)</size></box></geometry>
          <material><ambient>0.05 0.35 0.80 1</ambient><diffuse>0.05 0.45 0.95 1</diffuse></material>
        </visual>
        <collision name="box_wall_x_minus">
          <pose>-$(arg box_wall_x) 0 $(arg box_wall_z) 0 0 0</pose>
          <geometry><box><size>$(arg box_wall_thickness) $(arg box_size_y) $(arg box_height)</size></box></geometry>
        </collision>
        <collision name="box_wall_x_plus">
          <pose>$(arg box_wall_x) 0 $(arg box_wall_z) 0 0 0</pose>
          <geometry><box><size>$(arg box_wall_thickness) $(arg box_size_y) $(arg box_height)</size></box></geometry>
        </collision>
        <collision name="box_wall_y_minus">
          <pose>0 -$(arg box_wall_y) $(arg box_wall_z) 0 0 0</pose>
          <geometry><box><size>$(arg box_size_x) $(arg box_wall_thickness) $(arg box_height)</size></box></geometry>
        </collision>
        <collision name="box_wall_y_plus">
          <pose>0 $(arg box_wall_y) $(arg box_wall_z) 0 0 0</pose>
          <geometry><box><size>$(arg box_size_x) $(arg box_wall_thickness) $(arg box_height)</size></box></geometry>
        </collision>
        <visual name="box_wall_x_minus_visual">
          <pose>-$(arg box_wall_x) 0 $(arg box_wall_z) 0 0 0</pose>
          <geometry><box><size>$(arg box_wall_thickness) $(arg box_size_y) $(arg box_height)</size></box></geometry>
          <material><ambient>0.05 0.35 0.80 1</ambient><diffuse>0.05 0.45 0.95 1</diffuse></material>
        </visual>
        <visual name="box_wall_x_plus_visual">
          <pose>$(arg box_wall_x) 0 $(arg box_wall_z) 0 0 0</pose>
          <geometry><box><size>$(arg box_wall_thickness) $(arg box_size_y) $(arg box_height)</size></box></geometry>
          <material><ambient>0.05 0.35 0.80 1</ambient><diffuse>0.05 0.45 0.95 1</diffuse></material>
        </visual>
        <visual name="box_wall_y_minus_visual">
          <pose>0 -$(arg box_wall_y) $(arg box_wall_z) 0 0 0</pose>
          <geometry><box><size>$(arg box_size_x) $(arg box_wall_thickness) $(arg box_height)</size></box></geometry>
          <material><ambient>0.05 0.35 0.80 1</ambient><diffuse>0.05 0.45 0.95 1</diffuse></material>
        </visual>
        <visual name="box_wall_y_plus_visual">
          <pose>0 $(arg box_wall_y) $(arg box_wall_z) 0 0 0</pose>
          <geometry><box><size>$(arg box_size_x) $(arg box_wall_thickness) $(arg box_height)</size></box></geometry>
          <material><ambient>0.05 0.35 0.80 1</ambient><diffuse>0.05 0.45 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
